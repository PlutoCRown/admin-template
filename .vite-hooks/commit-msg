#!/usr/bin/env sh
# Git 会把提交说明文件路径作为第一个参数传入。
file=$1
header=$(sed -n '1p' "$file" | tr -d '\r')

case "$header" in
"" | \#*)
  exit 0
  ;;
Merge\ * | Revert\ * | fixup!\ * | squash!\ *)
  exit 0
  ;;
esac

if printf '%s\n' "$header" |
  grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9/_-]+\))?(!)?: [^ ].+$'; then
  exit 0
fi

cat <<'EOF'
提交说明需要符合 Conventional Commits：

  <type>(<scope>)?: <subject>

type: feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert

示例：
  feat(auth): 增加登录态持久化
  fix: 修复上传排序后预览错位
  chore: 升级 Vite+
EOF
exit 1
